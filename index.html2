<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAY ROGA | Premium Travel Architecture</title>
    
    <!-- ANALÍTICA ANÓNIMA Y PRIVADA (PLAUSIBLE) -->
    <script defer data-domain="tu-dominio-mayroga.com" src="https://plausible.io"></script>
    <script>
        window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }
    </script>

    <style>
        :root {
            --bg-obsidian: #030305;          
            --luxury-card: #0a0a0e;   
            --gold-champagne: #C5A059;        
            --gold-glow: rgba(197, 160, 89, 0.4);
            --white-ivory: #FFFFFF;        
            --text-muted: #8E8E93;
            --wellness-green: #3D9970;  
            --relax-blue: #1C3D5A;
            --alert-crimson: #E04F4F;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
        body {
            background-color: var(--bg-obsidian); color: var(--white-ivory);
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
            display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 16px;
            overflow-y: auto;
        }
        .app-window {
            max-width: 460px; width: 100%;
            background: linear-gradient(145deg, rgba(15, 15, 18, 0.99), rgba(3, 3, 5, 1));
            backdrop-filter: blur(30px); border: 1px solid rgba(197, 160, 89, 0.2);
            border-radius: 32px; padding: 40px 28px;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.95), 0 0 60px rgba(197, 160, 89, 0.04);
            position: relative; overflow: hidden;
        }
        header { border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 16px; margin-bottom: 24px; text-align: center; }
        header h1 { font-size: 28px; font-weight: 200; letter-spacing: 7px; color: var(--gold-champagne); text-transform: uppercase; font-family: "Times New Roman", Times, serif; margin: 0; }
        
        .lang-container-giant { display: flex; gap: 16px; margin-bottom: 24px; }
        .giant-lang-btn {
            flex: 1; background: rgba(255,255,255,0.01); border: 2px solid var(--gold-champagne);
            color: var(--gold-champagne); padding: 20px; border-radius: 16px; font-size: 16px;
            font-weight: 700; letter-spacing: 2px; cursor: pointer; transition: all 0.3s ease;
        }
        .giant-lang-btn.active-lang { background: var(--gold-champagne); color: var(--bg-obsidian); box-shadow: 0 0 20px var(--gold-glow); }

        h2 { font-size: 19px; font-weight: 300; letter-spacing: 0.5px; margin-bottom: 20px; line-height: 1.4; text-align: center; color: var(--white-ivory); }
        p { font-size: 14px; font-weight: 300; line-height: 1.7; color: var(--text-muted); margin-bottom: 24px; text-align: center; }
        
        .gold-btn {
            width: 100%; background: transparent; border: 1px solid var(--gold-champagne);
            color: var(--gold-champagne); padding: 18px; border-radius: 50px;
            font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
            cursor: pointer; transition: all 0.4s ease; margin-bottom: 12px;
        }
        .gold-btn:hover:not(:disabled) { background: var(--gold-champagne); color: var(--bg-obsidian); box-shadow: 0 0 20px var(--gold-glow); }

        .triple-option-btn {
            width: 100%; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08);
            color: var(--white-ivory); padding: 16px 20px; border-radius: 14px; font-size: 14px;
            font-weight: 300; text-align: left; cursor: pointer; transition: all 0.3s ease; margin-bottom: 10px; line-height: 1.4;
        }
        .triple-option-btn.correct-choice { background-color: var(--wellness-green) !important; border-color: var(--wellness-green) !important; color: white !important; font-weight: 500; }
        .triple-option-btn.wrong-choice { background-color: var(--alert-crimson) !important; border-color: var(--alert-crimson) !important; color: white !important; }

        .timeline-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .timer-display { font-size: 34px; font-family: "SF Mono", Consolas, monospace; font-weight: 200; color: var(--alert-crimson); text-shadow: 0 0 15px rgba(224, 79, 79, 0.4); }

        /* EL MOTOR VISUAL TEATRAL SENSORIAL DEL TRIÁNGULO */
        .graphics-container {
            background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.03);
            padding: 24px; border-radius: 20px; margin-bottom: 30px; min-height: 200px;
            display: none; justify-content: space-between; align-items: center; transition: all 0.5s ease;
        }
        .triangle-canvas { width: 170px; height: 150px; position: relative; border-bottom: 2px solid rgba(255,255,255,0.05); }
        .vertex-node { width: 10px; height: 10px; border-radius: 50%; position: absolute; filter: blur(1px); }
        .v-top { top: -5px; left: 80px; background-color: var(--alert-crimson); box-shadow: 0 0 15px var(--alert-crimson); } 
        .v-left { bottom: -5px; left: -5px; background-color: var(--relax-blue); box-shadow: 0 0 15px var(--relax-blue); }  
        .v-right { bottom: -5px; right: -5px; background-color: var(--text-muted); box-shadow: 0 0 15px var(--text-muted); } 
        
        .triangle-canvas::before, .triangle-canvas::after {
            content: ''; position: absolute; top: 0; width: 1.5px; height: 165px;
            background: linear-gradient(180deg, var(--gold-champagne), rgba(197, 160, 89, 0.02)); transform-origin: top;
        }
        .triangle-canvas::before { left: 85px; transform: rotate(28.5deg); }
        .triangle-canvas::after { left: 85px; transform: rotate(-28.5deg); }

        .energy-beam {
            width: 3px; height: 0; position: absolute; top: 0; left: 85px;
            background: linear-gradient(180deg, var(--alert-crimson), var(--gold-champagne));
            opacity: 0; transition: all 1.5s ease-in-out;
        }
        .beam-active { height: 150px; opacity: 0.7; }

        .breathe-canvas-pane { width: 100%; min-height: 180px; display: flex; justify-content: center; align-items: center; position: relative; margin-bottom: 25px; }

        /* CÍRCULO DEL PULMÓN BIOLÓGICO CON LIMITES ERGONÓMICOS */
        .center-wellness-circle {
            width: 50px; height: 50px; border-radius: 50%;
            background: radial-gradient(circle, #C5A059 0%, #91723B 100%);
            box-shadow: 0 0 35px var(--gold-champagne); z-index: 10;
            transition: width 4s linear, height 4s ease-in-out, background-color 1.5s linear;
        }
        .lung-inhale { width: 130px; height: 130px; background: radial-gradient(circle, #1C3D5A 0%, #0B1D33 100%) !important; box-shadow: 0 0 50px rgba(28,61,90,0.8) !important; }
        .lung-exhale { width: 50px; height: 50px; background: radial-gradient(circle, #E04F4F 0%, #992222 100%) !important; box-shadow: 0 0 25px rgba(224,79,79,0.5) !important; }

        .silhouette-display-box { width: 130px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .avatar-silhouette {
            width: 44px; height: 115px; background: linear-gradient(180deg, #16161a 0%, #08080a 100%);
            border: 1px solid rgba(255,255,255,0.06); border-radius: 20px; position: relative; transition: all 1.5s ease;
        }
        .satisfactory-node { width: 14px; height: 14px; border-radius: 3px; background-color: #222; border: 1px solid #333; margin-top: 10px; transition: all 0.8s ease; }
        .node-success { background-color: var(--wellness-green) !important; box-shadow: 0 0 15px var(--wellness-green) !important; border-color: var(--wellness-green) !important; }

        .explanation-card { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(197, 160, 89, 0.2); padding: 16px; border-radius: 12px; margin-top: 14px; margin-bottom: 14px; font-size: 13.5px; line-height: 1.6; text-align: left; color: var(--gold-champagne); display: none; }

        .ecosystem-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 25px; }
        .grid-tile {
            background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);
            padding: 18px; border-radius: 16px; text-decoration: none; color: var(--white-ivory);
            font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase;
            display: flex; flex-direction: column; align-items: center; gap: 6px; transition: all 0.3s ease; text-align: center;
        }
        .grid-tile:hover { background: rgba(197, 160, 89, 0.06); border-color: var(--gold-champagne); transform: translateY(-3px); }
        .tile-subtext { font-size: 10px; color: var(--text-muted); text-transform: none; }
    </style>
</head>
<body>
<div class="app-window">
    <header><h1>MAY ROGA</h1></header>

    <!-- LOS DOS GIGANTES BOTONES DE IDIOMA COMO PRIORIDAD SOBERANA -->
    <div class="lang-container-giant" id="giantLangBox">
        <button class="giant-lang-btn active-lang" id="btnLangES" onclick="window.KERNEL.setLanguage('ES')">ESPAÑOL</button>
        <button class="giant-lang-btn" id="btnLangEN" onclick="window.KERNEL.setLanguage('EN')">ENGLISH</button>
    </div>

<!-- EL MOTOR VISUAL TEATRAL SENSORIAL (3 FIJOS Y 2 ALEATORIOS = 5 APARICIONES EN TOTAL) -->
    <div class="graphics-container" id="engineWrapper" style="display:none;">
        <div class="triangle-canvas">
            <div class="vertex-node v-top"></div>
            <div class="vertex-node v-left"></div>
            <div class="vertex-node v-right"></div>
            <div class="energy-beam" id="energyBeam"></div>
        </div>
        <div class="center-wellness-circle" id="lungCircle"></div>
    </div>

<script>
let detectedMood = "tranquilidad";

// BASE DE DATOS DE MENOR A MAYOR COMPLEJIDAD
const POOL_EJERCICIOS = [
    { 
        id: 0, tipo: "PREGUNTA", q_es: "En este preciso instante de tu día, ¿qué es lo que más le urge experimentar a tu atención?", q_en: "At this exact moment of your day, what does your attention urgently seek to experience?", 
        opts_es: [
            {t:"A. Tranquilidad total, desconexión y silencio absoluto.",p:25,c:true,ex:"Procesando vector de Paz... Adaptando frecuencias del acompañante.",mood:"tranquilidad"}, 
            {t:"B. Romper la monotonía, explorar nuevos entornos vibrantes.",p:15,c:false,ex:"Procesando vector de Estímulo... Activando retos de agilidad cognitiva.",mood:"estresado"}, 
            {t:"C. Descanso físico tras una jornada de agotamiento acumulado.",p:5,c:false,ex:"Procesando vector de Recuperación... Calibrando pulmón biológico.",mood:"agotado"}
        ], 
        opts_en: [
            {t:"A. Absolute tranquility, disconnection, and perfect silence.",p:25,c:true,ex:"Processing Peace vector... Adapting companion audio frequencies.",mood:"tranquilidad"}, 
            {t:"B. Breaking monotony, exploring new vibrant enclaves.",p:15,c:false,ex:"Processing Stimulus vector... Invoking cognitive speed challenges.",mood:"estresado"}, 
            {t:"C. Physical rest following accumulated fatigue loops.",p:5,c:false,ex:"Processing Recovery vector... Adjusting biological lung rhythms.",mood:"agotado"}
        ] 
    },
    { 
        id: 1, tipo: "PREGUNTA", q_es: "Frente al flujo de decisiones diarias en tu negocio, ¿cómo opera tu enfoque mental?", q_en: "Facing daily business choices, how does your strategic focus operate?", 
        opts_es: [
            {t:"A. Fluye con total claridad, manteniendo el orden de las prioridades.",p:25,c:true,ex:"Excelente. El orden natural sostiene la lucidez."}, 
            {t:"B. Avanzo de forma constante, pero el ritmo se acelera bajo presión.",p:15,c:false,ex:"Atención: la aceleración continua genera un desgaste de energía invisible."}, 
            {t:"C. Siento la inercia de la rutina antes de iniciar mis actividades.",p:5,c:false,ex:"Alerta: tu mente ejecuta cargas secundarias antes de tiempo en piloto automático."}
        ], 
        opts_en: [
            {t:"A. It flows with absolute clarity, keeping core priorities in command.",p:25,c:true,ex:"Splendid. Natural order sustains executive baseline lucidity."}, 
            {t:"B. I move steadily, but workflow speed accelerates under pressure.",p:15,c:false,ex:"Caution: endless high-speed operational loops drain underlying energy."}, 
            {t:"C. I experience routine fatigue before even initializing tasks.",p:5,c:false,ex:"Overload warning: your brain runs background tasks prematurely."}
        ] 
    },
    { 
        id: 2, tipo: "MATEMATICA", q_es: "Un reto numérico divertido: Si una aeronave privada vuela a 600 mph, ¿cuántas millas cruza en 15 minutos exactos?", q_en: "A quick logical challenge: If a private jet cruise speeds at 600 mph, how many miles does it cross in exactly 15 minutes?", 
        opts_es: [
            {t:"A. Avanza exactamente 100 millas.",p:0,c:false,ex:"Incorrecto. Evalúa el cuadrante del tiempo: 15 minutos es un cuarto de hora perfecta."}, 
            {t:"B. Avanza exactamente 150 millas.",p:25,c:true,ex:"¡Extraordinario! 150 millas. Tu agilidad lógica permanece impecable y despierta."}, 
            {t:"C. Avanza exactamente 200 millas.",p:0,c:false,ex:"Incorrecto. Vuelve a calibrar dividiendo la velocidad entre cuatro bloques de tiempo."}
        ], 
        opts_en: [
            {t:"A. It covers exactly 100 miles.",p:0,c:false,ex:"Incorrecto. Look closely at the temporal quadrant: 15 minutes is a perfect quarter."}, 
            {t:"B. It covers exactly 150 miles.",p:25,c:true,ex:"Brilliant! 150 miles. Your logical processing speed remains pristine and alert."}, 
            {t:"C. It covers exactly 200 miles.",p:0,c:false,ex:"Incorrecto. Re-calibrate by dividing full speed into four quarters."}
        ] 
    }
];

const VOCABULARIO_MUTANTE = {
    es: {
        tranquilidad: ["Disfruta el momento.", "Suelta la prisa.", "El silencio es poder.", "Paz profunda.", "Estás a salvo aquí.", "Respira el presente.", "La calma repara tu centro."],
        estresado: ["Enfoque limpio.", "Agilidad mental.", "Claridad estratégica.", "Control absoluto.", "Calibra tus decisiones.", "Visualiza el éxito.", "Fuerza interna."],
        agotado: ["Descansa profundamente.", "Recupera tu energía.", "Suelta el peso de la rutina.", "Relaja los hombros hoy.", "Renovación de fondo."]
    },
    en: {
        tranquilidad: ["Enjoy the moment.", "Release the rush.", "Silence is absolute leverage.", "Deep peace.", "You are safe within this space.", "Breathe the present.", "Stillness restores your core."],
        estresado: ["Sharp focus.", "Mental clarity.", "Strategic bandwidth.", "Absolute command.", "Calibrate your perspective.", "Visualize results.", "Internal resilience."],
        agotado: ["Rest fully.", "Restore your base energy.", "Release routine fatigue.", "Relax your shoulders today.", "Underlying tranquility."]
    }
};

const VOCABULARIO_SABIDURIA = {
    es: ["La verdadera riqueza es el control absoluto sobre tu tiempo.", "Un líder en armonía toma decisiones con un margen de ganancia infinito.", "El descanso no es una pérdida de tracción; es la arquitectura del siguiente paso."],
    en: ["True wealth is possessing complete sovereignty over your attention.", "A leader anchored in calm commands an unshakeable premium margin.", "Rest is not a lack of momentum; it is the structural blueprint of your next move."]
};

const BASE_SANTUARIOS = [
    { id: "H1", tier: "ELITE", name_es: "Eden Roc Cap Cana (Punta Cana)", name_en: "Eden Roc Cap Cana (Dominican Republic)", desc_es: "Bungalows de ultra-lujo con alberca propia y club de playa privado.", desc_en: "Ultra-luxury standalone bungalows featuring private pools and beach clubs.", maps: "google.com", yt: "youtube.com" },
    { id: "H2", tier: "ELITE", name_es: "Amanera Resort (Playa Grande)", name_en: "Amanera Resort (Playa Grande)", desc_es: "Casitas de cristal y ebanistería minimalista suspendidas sobre acantilados masivos.", desc_en: "Minimalist glass casitas perched on massive ocean cliffs.", maps: "google.com", yt: "youtube.com" },
    { id: "H3", tier: "PREMIUM", name_es: "Grand Velas Riviera Maya (México)", name_en: "Grand Velas Riviera Maya (Mexico)", desc_es: "Suites de alta gama acompañadas de un circuito hidrotermal de spa guiado.", desc_en: "Upscale beachfront suites paired with an immersive guided hydrothermal spa circuit.", maps: "google.com", yt: "youtube.com" }
];

const BASE_PASILLOS = {
    "ELITE": {
        es: { air: "Gulfstream G650 Chárter Privado directo sin filas desde la terminal VIP FBO de Miami.", sea: "The Ritz-Carlton Yacht Collection Suite de popa con terraza privada sobre el océano." },
        en: { air: "Gulfstream G650 Private Charter direct from Miami's VIP FBO terminal with zero lines.", sea: "The Ritz-Carlton Yacht Collection premium suite with a private ocean-facing terrace." }
    },
    "PREMIUM": {
        es: { air: "Clase Ejecutiva Flagship Suite con asientos Lie-Flat totalmente reclinables en vuelo directo.", sea: "Celebrity Cruises (The Retreat Enclave) con solárium y restaurante de autor VIP." },
        en: { air: "Flagship Business Class Suite featuring fully reclinable lie-flat non-stop seating.", sea: "Celebrity Cruises (The Retreat Enclave) granting VIP sundeck access and upscale dining." }
    }
};

const TEXTOS_INTERFAZ = {
    es: {
        unlock_ready: "INICIAR", phase_silence: "Reto de Silencio Absoluto",
        skip_btn: "Saltar Ejercicio de Silencio", next_btn: "Continuar Trayecto",
        stay_lbl: "🏨 Estancia:", air_lbl: "✈️ Logística Aérea:", sea_lbl: "⚓ Canales de Mar:",
        pdf_btn: "Descargar libreta de viaje (PDF)", eco_title: "Ecosistema de Salida Directa",
        results_title: "Tu Destino Curado de Compensación",
        results_desc: "Procesamos tus canales de forma anónima y local. Nuestro sistema prescribe las siguientes coordinaciones:",
        action_active: "Calma Activa", action_sat: "Saturación Crítica", action_arm: "Armonía Lograda"
    },
    en: {
        unlock_ready: "INICIAR", phase_silence: "Absolute Silence Ritual",
        skip_btn: "Skip Silence Exercise", next_btn: "Continue Itinerary",
        stay_lbl: "🏨 Curated Oasis:", air_lbl: "✈️ Premium Air Logistics:", sea_lbl: "⚓ Maritime Cruise Corridor:",
        pdf_btn: "Download My Travel Passport (PDF)", eco_title: "Direct Gateway Ecosystem",
        results_title: "Your Curated Travel Prescription",
        results_desc: "We have processed your focus vectors locally. Our system compiles the following parameters:",
        action_active: "Active Calibration", action_sat: "Critical Overload", action_arm: "Harmony Achieved"
    }
};

let serviceTimer = null, voiceInterval = null, breatheInterval = null, currentQuestionIndex = 0, timeRemaining = 15 * 60;
let userAnswers = [], currentTier = "ELITE", sessionData = null, currentLang = "ES", silenceTimeout = null;

let randomMoment1 = Math.floor(Math.random() * (13 * 60 - 9 * 60) + 9 * 60); 
let randomMoment2 = Math.floor(Math.random() * (6 * 60 - 2 * 60) + 2 * 60);

window.KERNEL = {
    setLanguage: function(lang) {
        currentLang = lang;
        document.getElementById('btnLangES').className = lang === "ES" ? "giant-lang-btn active-lang" : "giant-lang-btn";
        document.getElementById('btnLangEN').className = lang === "EN" ? "giant-lang-btn active-lang" : "giant-lang-btn";
        let map = TEXTOS_INTERFAZ[currentLang.toLowerCase()];
        document.getElementById('lblLegalTitle').innerText = currentLang === "ES" ? "Tu espacio privado de sintonía" : "Your private tuning residency";
        document.getElementById('btnUnlock').innerText = map.unlock_ready;
        this.hablar();
    },
    init: function() {
        document.getElementById('giantLangBox').style.display = 'none';
        document.getElementById('panelLegal').style.display = 'none';
        document.getElementById('panelService').style.display = 'block';
        let engine = document.getElementById('engineWrapper');
        if(engine) engine.style.display = 'flex';
        setTimeout(() => { if(engine) engine.style.display = 'none'; }, 20000);
        this.hablar();
        this.iniciarPulmonVisual();
        this.cargarFlujoSiguienteLocalStorage();
        serviceTimer = window.setInterval(() => {
            timeRemaining--;
            let mins = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
            let secs = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('clockDisplay').innerText = `${mins}:${secs}`;
            if(timeRemaining === (7 * 60 + 30) || timeRemaining === randomMoment1 || timeRemaining === randomMoment2) {
                if(engine) engine.style.display = 'flex';
                setTimeout(() => { if(engine) engine.style.display = 'none'; }, 20000);
            }
            if(timeRemaining === 30) {
                if(engine) engine.style.display = 'flex';
                this.finalizarAcompanamientoCRM();
            }
        }, 1000);
    },
    hablar: function() {
        if(voiceInterval) window.clearInterval(voiceInterval);
        let count = 0;
        const emitirVozOasis = () => {
            if ('speechSynthesis' in window) {
                let frase = ""; count++;
                if(count % 3 === 0) {
                    let poolS = VOCABULARIO_SABIDURIA[currentLang.toLowerCase()];
                    frase = poolS[Math.floor(Math.random() * poolS.length)];
                } else {
                    let poolM = VOCABULARIO_MUTANTE[currentLang.toLowerCase()][detectedMood];
                    frase = poolM[Math.floor(Math.random() * poolM.length)];
                }
                let utterance = new SpeechSynthesisUtterance(frase);
                utterance.lang = currentLang === "ES" ? "es-US" : "en-US";
                window.speechSynthesis.speak(utterance);
            }
        };
        emitirVozOasis(); voiceInterval = window.setInterval(emitirVozOasis, 15000);
    },
    iniciarPulmonVisual: function() {
        if(breatheInterval) window.clearInterval(breatheInterval);
        let alternarLung = true;
        breatheInterval = window.setInterval(() => {
            let circle = document.getElementById('lungCircle'); if(!circle) return;
            circle.className = alternarLung ? "center-wellness-circle lung-inhale" : "center-wellness-circle lung-exhale";
            alternarLung = !alternarLung;
        }, 4000);
    },
    cargarFlujoSiguienteLocalStorage: function() {
        if(!localStorage.getItem('mayroga_last_idx')) localStorage.setItem('mayroga_last_idx', "0");
        let lastIdx = parseInt(localStorage.getItem('mayroga_last_idx'));
        if(lastIdx >= POOL_EJERCICIOS.length || userAnswers.length >= 3) return;
        if(lastIdx === 1) this.inyectarRetoSilencioEscalonado(); 
        else this.inyectarPreguntaDom(POOL_EJERCICIOS[lastIdx]);
    },
    inyectarPreguntaDom: function(nodo) {
        let stack = document.getElementById('interactiveStack');
        document.getElementById('lblTaskTitle').innerText = currentLang === "ES" ? nodo.q_es : nodo.q_en;
        let html = ""; let opts = currentLang === "ES" ? nodo.opts_es : nodo.opts_en;
        opts.forEach((o, i) => {
            html += `<button class="triple-option-btn" onclick="window.KERNEL.evaluarSeleccion(${o.p}, ${o.c}, '${o.ex}', ${i}, '${o.mood || ''}')">${o.t}</button>`;
        });
        stack.innerHTML = html;
    },
    evaluarSeleccion: function(puntos, esCorrecto, explicacion, indexBtn, moodElegido) {
        let box = document.getElementById('lblExplanationBox');
        if(moodElegido) { detectedMood = moodElegido; this.hablar(); }
        userAnswers.push(puntos); 
        if(box) { box.innerText = explicacion; box.style.display = 'block'; }
        document.getElementById('btnNext').style.display = 'block';
    },
    inyectarRetoSilencioEscalonado: function() {
        let duracionSilen = parseInt(localStorage.getItem('mayroga_silence_dur') || "40");
        document.getElementById('lblTaskTitle').innerText = TEXTOS_INTERFAZ[currentLang.toLowerCase()].phase_silence;
        document.getElementById('interactiveStack').innerHTML = `<p>${duracionSilen}s</p>`;
        silenceTimeout = setTimeout(() => { userAnswers.push(25); this.avanzarRetoContinuo(); }, duracionSilen * 1000);
    },
    avanzarRetoContinuo: function() {
        let idx = parseInt(localStorage.getItem('mayroga_last_idx')) + 1;
        localStorage.setItem('mayroga_last_idx', idx.toString());
        this.cargarFlujoSiguienteLocalStorage();
    },
    finalizarAcompanamientoCRM: function() {
        window.clearInterval(serviceTimer);
        document.getElementById('panelService').style.display = 'none';
        document.getElementById('panelResults').style.display = 'block';
    }
};
</script>
