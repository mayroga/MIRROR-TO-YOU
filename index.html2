        // Inicialización del motor dinámico respetando tu chasis original
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof initializeEliteSession === "function") {
                initializeEliteSession(
                    RAW_RIDDLES_DATABASE, 
                    RAW_RIDDLES_DATABASE, 
